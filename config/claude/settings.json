{
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh",
    "padding": 0,
    "refreshInterval": 30
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "dark",
  "env": {
    "CLAUDE_CODE_TMUX_TRUECOLOR": "1"
  }
}
